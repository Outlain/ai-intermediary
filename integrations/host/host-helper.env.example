# Set the EXACT Ollama upstream origin configured in the intermediary, not its
# public 11435 proxy URL and not Frigate. Do not assume this example is yours.
MANAGED_OLLAMA_ORIGIN=http://192.0.2.10:11434
# Locate using `command -v amd-smi`, then use the absolute root-owned path.
AMD_SMI_PATH=/opt/rocm/bin/amd-smi
HOST_HELPER_SOCKET=/run/ai-intermediary-host/control.sock
HOST_HELPER_STATE=/var/lib/ai-intermediary-host/state.json
# Optional READ-ONLY ComfyUI process attribution. Add only trusted local systemd
# units running ComfyUI. Maximum eight comma-separated .service names. This
# does not authorize restarting ComfyUI, reset the GPU, or reboot the host.
# Keep this environment file root-owned and not writable by application users.
COMFYUI_SYSTEMD_UNITS=
