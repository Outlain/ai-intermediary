[Unit]
Description=AI Intermediary local AMD telemetry and bounded Ollama recovery helper
After=ollama.service

[Service]
Type=simple
User=ai-intermediary-host
Group=ai-intermediary-host
SupplementaryGroups=render video
EnvironmentFile=/etc/ai-intermediary-host.env
ExecStart=/usr/bin/python3 /opt/ai-intermediary-host/host_helper.py
WorkingDirectory=/opt/ai-intermediary-host
RuntimeDirectory=ai-intermediary-host
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
StateDirectory=ai-intermediary-host
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
# sudo needs setuid for the one exact sudoers command. NoNewPrivileges would
# prohibit that command; the helper itself and configuration remain root-owned.
# AMD telemetry requires render/video devices and readable /proc cgroups.

[Install]
WantedBy=multi-user.target
