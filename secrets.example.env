# Copy this file to secrets.env. Docker Compose passes these values to the container,
# and config.yml/config.example.yml expands ${VARIABLE} placeholders at startup.

OLLAMA_URL=http://192.0.2.10:11434

# Optional Frigate IP/CIDR classification. Unmatched requests use the Odysseus
# policy, so Odysseus needs no stable Docker IP. Leave blank until Frigate is added.
FRIGATE_SOURCE=

# Frigate API connection for persistent description recovery (not the Ollama URL).
# Origin only, e.g. https://frigate.example:8971; also editable through Settings.
FRIGATE_URL=
# An admin account with access to the relevant cameras. Login refresh is automatic.
FRIGATE_USERNAME=
FRIGATE_PASSWORD=
# Optional alternative to username/password. Expired static tokens require renewal.
FRIGATE_AUTH_TOKEN=

# One human administrator credential for Dashboard, Settings, maintenance and
# the media interface. Generate once with: openssl rand -hex 32
# Keep it private: anyone holding it can change settings and operate recovery.
ADMIN_TOKEN=

# Optional host monitoring and Ollama-only bounded recovery. Leave unset until
# integrations/host is installed and its socket directory is mounted. These
# establish base settings; saved UI overrides win.
# Accepted booleans are exactly true, false, 1, or 0 (no embedded quote characters).
# HOST_HELPER_ENABLED=true
# HOST_HELPER_SOCKET_PATH=/run/ai-intermediary-host/control.sock
# AUTO_RECOVERY_ENABLED=true
# Later, after installing ComfyUI, run scripts/configure-comfy-auth.py to write
# its separate derived machine credential. You do not choose or copy a second
# human password. Do not expose ADMIN_TOKEN to ComfyUI or workflow JSON.
