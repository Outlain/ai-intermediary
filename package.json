{
  "name": "ai-intermediary",
  "version": "2.0.4",
  "description": "AI Intermediary: one-GPU scheduling for Ollama and durable local ComfyUI workflows",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js",
    "check:public": "node scripts/publication-check.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec test/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/*.test.js"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  }
}
